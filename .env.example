# PHASE 4.7 画像素材づくりの設定（開発時だけ使う）
#
# このファイルは見本です。実際の鍵は .env に書いてください。
# .env は .gitignore に入っているので、git には入りません。
#
# ゲーム本体はこの設定を一切読みません。
# ビルドされた HTML にも、manifest にも、鍵は入りません。

# どこで画像を作るか: openai / replicate / fal / local
# local は API を使いません。手元で作った PNG を assets/incoming/ へ置くだけです。
IMAGE_PROVIDER=

# 画像生成の鍵。local のときは要りません。
# 絶対に git へ入れないでください。
IMAGE_API_KEY=

# 使うモデル（省略すると各プロバイダーの既定値）
# openai:    gpt-image-1
# replicate: black-forest-labs/flux-1.1-pro
# fal:       fal-ai/flux/dev
IMAGE_MODEL=

# 宛先を変えるとき（社内の中継サーバーなど）。ふつうは空のままで構いません。
IMAGE_BASE_URL=
