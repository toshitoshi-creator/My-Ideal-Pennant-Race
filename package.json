{
  "name": "my-ideal-pennant-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "node e2e/smoke.mjs",
    "verify": "tsc --noEmit -p tsconfig.json && vitest run && vite build && node e2e/run-with-preview.mjs",
    "e2e:seeds": "node e2e/run-seeds.mjs",
    "e2e:sandbox": "node e2e/sandbox-check.mjs",
    "assets:manifest": "node scripts/generate-asset-manifest.mjs",
    "assets:validate": "node scripts/validate-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:audit": "node scripts/audit-player-assets.mjs",
    "assets:dry-run": "npx tsx scripts/assets-cli.ts dry-run",
    "assets:generate": "npx tsx scripts/assets-cli.ts generate",
    "assets:regenerate": "npx tsx scripts/assets-cli.ts regenerate",
    "assets:process": "npx tsx scripts/assets-cli.ts process",
    "assets:check": "npx tsx scripts/assets-cli.ts check",
    "assets:prompts": "npx tsx scripts/assets-cli.ts prompts",
    "assets:gallery": "npx tsx scripts/visual-gallery.tsx",
    "gallery": "npx tsx scripts/visual-gallery.tsx",
    "e2e:images": "node e2e/image-mode-check.mjs",
    "audit:security": "node scripts/security-audit.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
